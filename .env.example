# Required: Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Required: PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Required: Owner Discord User ID (full access to all commands)
OWNER_ID=123456789012345678

# Role Configuration (comma-separated IDs)
FULL_ACCESS_ROLE_IDS=123456789012345678,234567890123456789
VIEW_ACCESS_ROLE_ID=345678901234567890
GUEST_ROLE_ID=456789012345678901
SETTLER_ROLE_ID=567890123456789012
CITIZEN_ROLE_IDS=678901234567890123,789012345678901234

# Channel Configuration
COUNCIL_CHANNEL_ID=890123456789012345
REGISTRY_CHANNEL_ID=901234567890123456
AUDIT_LOG_CHANNEL_ID=012345678901234567

# Monthly census report destination
# Channel that receives the monthly population snapshot, and the role to ping.
MONTHLY_REPORT_CHANNEL_ID=012345678901234567
MONTHLY_REPORT_ROLE_ID=1067779118030143549

# Network & Timeout Settings
AIOHTTP_TOTAL_TIMEOUT=5
AIOHTTP_CONNECT_TIMEOUT=3

# Cooldown Configuration (in seconds)
# These define per-user rate limits for different command categories
COOLDOWN_FAST=5          # Quick view/list commands
COOLDOWN_MEDIUM=15       # Data modification commands
COOLDOWN_SLOW=60         # Expensive operations (reports)
COOLDOWN_CRITICAL=120    # Very expensive ops (backup/restore)

# CivInfo API Rate Limiting
CIVINFO_API_RATE_LIMIT=10

# CivInfo API Key (optional but now required by the API).
# Contact minecraft.gjum@gmail.com for a key. When unset or rejected, the bot
# degrades gracefully — reports show "Activity data unavailable" instead of
# fake "0 active" counts. Leave blank if you don't have one yet.
CIVINFO_API_KEY=

# --- CivMC Server Status (mcsrvstat.us, no auth required) ---
# The Minecraft server address polled by /server status and the uptime monitor.
SERVER_ADDRESS=play.civmc.net
# mcsrvstat.us API base (v3). Override only if you need a mirror.
MCSRVSTAT_API_BASE=https://api.mcsrvstat.us/3

# Channel that receives edge-triggered outage / recovery alerts when CivMC
# goes down or comes back up. 0 = disabled (uptime monitor still runs, just
# doesn't post anywhere).
ALERT_CHANNEL_ID=012345678901234567
# How often (seconds) to poll server status. Min 60 (mcsrvstat rate limit).
UPTIME_CHECK_INTERVAL=300

# Backup Directory
BACKUP_DIR=backups

# Optional: Proxy URL for requests
PROXY_URL=
