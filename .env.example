# =====================================================================
# Lambat Registry Bot — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env.
# =====================================================================

# --- Required ---
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Discord user ID of the bot owner (full access to everything, including /sync)
OWNER_ID=123456789012345678

# --- Discord Guild (recommended for single-server nation bots) ---
# The ID of your nation's Discord server. When set, slash commands sync
# INSTANTLY on startup (instead of globally, which can take up to 1 hour).
# Right-click your server name > Copy ID (Developer Mode must be on).
GUILD_ID=0

# --- Roles (comma-separated IDs where applicable) ---
# Council / admin role(s) — can add/remove citizens, manage settlements, backup/restore.
FULL_ACCESS_ROLE_IDS=123456789012345678,234567890123456789
# Role that can view citizens / reports (but not modify).
VIEW_ACCESS_ROLE_ID=345678901234567890
# Role assigned to unregistered guests (removed when a citizen is registered).
GUEST_ROLE_ID=456789012345678901
# Settler role (assigned to all registered citizens).
SETTLER_ROLE_ID=567890123456789012
# Citizen role(s) — assigned to all registered citizens (can be multiple).
CITIZEN_ROLE_IDS=678901234567890123,789012345678901234

# --- Monthly Census Report ---
# Channel that receives the monthly population snapshot on the 1st of each month.
MONTHLY_REPORT_CHANNEL_ID=012345678901234567
# Role to ping when the monthly report is posted (0 = no ping).
MONTHLY_REPORT_ROLE_ID=012345678901234567

# --- CivInfo API (player activity data) ---
# The CivInfo API now requires authentication. Contact
# minecraft.gjum@gmail.com to request a key. When unset or rejected, the bot
# degrades gracefully: reports show "Activity data unavailable" instead of
# fake "0 active" counts, and /citizen add still works (with a warning).
CIVINFO_API_KEY=
# CivInfo API base URL. Override only for testing (e.g. a mock server).
CIVINFO_API_BASE=https://api.civinfo.net
# The mcServer value sent on every CivInfo request. The official frontend uses
# the full server address "play.civmc.net", not the short form "civmc".
CIVINFO_MC_SERVER=play.civmc.net
# The civinfo-version header (mirrors Gjum's official frontend git hash).
# Observational today; update if Gjum ever makes it required.
CIVINFO_FRONTEND_VERSION=1189803c19bf94a23f86a15d9ef2ab9f7654b929

# --- CivMC Server Status (mcsrvstat.us, no auth required) ---
# The Minecraft server address polled by /server status and the uptime monitor.
SERVER_ADDRESS=play.civmc.net
# mcsrvstat.us API base (v3). Override only if you need a mirror.
MCSRVSTAT_API_BASE=https://api.mcsrvstat.us/3

# Channel that receives edge-triggered outage/recovery alerts when CivMC goes
# down or comes back up. 0 = disabled (the monitor still runs, just doesn't post).
ALERT_CHANNEL_ID=012345678901234567
# How often (seconds) to poll server status. Minimum 60 (mcsrvstat rate limit).
UPTIME_CHECK_INTERVAL=300

# --- Network & Timeouts ---
AIOHTTP_TOTAL_TIMEOUT=5
AIOHTTP_CONNECT_TIMEOUT=3

# --- Cooldowns (seconds, per-user rate limits) ---
COOLDOWN_FAST=5          # Quick view/list commands
COOLDOWN_MEDIUM=15       # Data modification commands
COOLDOWN_SLOW=60         # Expensive operations (reports, exports)
COOLDOWN_CRITICAL=120    # Very expensive ops (backup, restore)

# --- Backups ---
# Directory for pg_dump backup files (relative to the working directory).
BACKUP_DIR=backups
# Max seconds before pg_dump / psql is killed (prevents wedged-DB hangs).
PG_TIMEOUT=180

# Off-site backup sink. In addition to the local copy in BACKUP_DIR, each backup
# is uploaded here. The local disk on Render/Railway is ephemeral, so uploading
# elsewhere is strongly recommended for production. One of: local, s3, gcs.
#   local  = no upload (default; disk-only, legacy behaviour)
#   s3     = upload to an S3-compatible bucket (requires `pip install boto3`)
#   gcs    = upload to a Google Cloud Storage bucket
#            (requires `pip install google-cloud-storage`)
BACKUP_SINK=local
# S3 settings (only used when BACKUP_SINK=s3). boto3 reads credentials from the
# standard chain: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS profile / IAM.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=lambat-backups
# GCS settings (only used when BACKUP_SINK=gcs). Credentials via
# GOOGLE_APPLICATION_CREDENTIALS.
BACKUP_GCS_BUCKET=
BACKUP_GCS_PREFIX=lambat-backups
# How many "auto" (daily) backups to keep on disk. Older auto backups are
# pruned after each create. Monthly backups (1st of the month), manual backups,
# and pre-restore emergency backups are NEVER pruned.
BACKUP_RETENTION_DAILY=30

# --- Optional ---
# HTTP proxy URL for outbound requests (leave blank for direct).
PROXY_URL=
# Port for the HTTP keep-alive + health server (Render/Railway liveness probe).
# The same server exposes /healthz (honest liveness: gateway + DB) and /metrics
# (basic Prometheus text). Render injects PORT automatically.
PORT=10000

# --- Logging & observability (Phase 1) ---
# Output format for log lines. "console" = human-readable (good for dev/Docker);
# "json" = one JSON object per line (good for Loki/Datadog/CloudWatch).
LOG_FORMAT=console
# Log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Log file path (relative to working dir). If it can't be opened, falls back
# to stdout-only without crashing.
LOG_FILE=lambat_bot.log
# Optional Sentry DSN for error tracking. Requires `pip install sentry-sdk`
# (or the [sentry] extra). Blank = disabled.
SENTRY_DSN=

# --- Audit log (Phase 2.1) ---
# Channel that receives a concise embed for every registry mutation (citizen
# add/update/remove, settlement add/remove, role-sync discrepancies). This is
# a read-only mirror of the audit_log table for the wider council. The full
# JSONB details are always written to the DB regardless; this just surfaces
# them in Discord. 0 = disabled (DB record still written).
AUDIT_CHANNEL_ID=0

# --- Role reconciliation (Phase 2.5) ---
# Weekly task that checks every citizen's Discord member still holds the
# citizen/settler/settlement roles and lacks the guest role. Discrepancies are
# logged to the audit channel + audit_log table. Set ROLE_SYNC_AUTO=true to
# also re-apply the correct roles automatically (default: report only).
ROLE_SYNC_AUTO=false
# Day-of-week to run the weekly check: 0=Mon, 1=Tue, ... 6=Sun.
ROLE_SYNC_WEEKLY_DAY=0
# Hour (UTC) to run the weekly check.
ROLE_SYNC_WEEKLY_HOUR=3

# --- Applications channel (Phase 3.4) ---
# Channel that receives an embed for every new /apply submission so council
# can review and approve/reject via the buttons. 0 = disabled (applications are
# still recorded in the DB, but no Discord notification is sent).
APPLICATIONS_CHANNEL_ID=0

# --- Governance notifications channel (Phase 3.7) ---
# A read-only mirror of registry mutations (citizen add/update/remove,
# settlement add/remove) for the WIDER council — a less technical audience
# than the audit channel. If this equals AUDIT_CHANNEL_ID or is 0, no separate
# governance post is made (the audit channel already covers it).
GOVERNANCE_CHANNEL_ID=0

# --- Graceful shutdown (Phase 4.1) ---
# Hard ceiling (seconds) for the whole shutdown sequence after the container
# orchestrator sends SIGTERM. If exceeded, we force-exit so the orchestrator
# never has to SIGKILL us (a SIGKILL loses in-flight log flushes + leaves the
# Discord gateway session dangling). 15s matches Render's default grace;
# Docker's default is 10s — set this a couple seconds BELOW your host's grace.
SHUTDOWN_GRACE_SECONDS=15

# --- Internationalisation (Phase 4.5) ---
# Default UI language for /help + the monthly report. 'en' is the only fully-
# translated locale; 'fil' (Filipino) is a partial stretch goal (the /help
# embed is translated; monthly-report headers fall back to en). The value
# must match a file stem in locales/ (without the .json), else tr() falls
# back to English. To add a new locale, drop a locales/xx.json file and set
# this to 'xx'.
LOCALE=en
